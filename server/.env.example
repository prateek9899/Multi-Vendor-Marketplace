NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/marketly
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
PLATFORM_COMMISSION_RATE=10

# Redis is optional. Remote Redis is disabled unless ALLOW_REMOTE_REDIS=true.
REDIS_HOST=localhost
REDIS_PORT=6379
ALLOW_REMOTE_REDIS=false

# Elasticsearch is optional and falls back to MongoDB search.
ELASTICSEARCH_NODE=http://localhost:9200

# S3 is optional. Without credentials, images are optimized and saved locally.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay test credentials are required for online checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set these only when running the one-time admin creation script.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
